// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// our first model that we want to add to mongodb will be our user
// user contains id, name, email, and password. additionally I will add emailVerified date/time so that sessions can expire (optional in case user selects google or githuub to sign in).
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId // mongodb decorator for id
  name         String
  email        String   @unique
  password     String
  emailVerified DateTime?
}

model VerificationToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  email String
  token String
  // @ts-ignore
  expires DateTime

  @@unique([email, token])
}
